# Copy to .env (never commit .env). Only placeholders here.
# Anthropic (default provider):
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
# OpenRouter (--provider openrouter --model <id>:free); key from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-REPLACE_ME
